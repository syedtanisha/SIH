# Security & Cryptography
SECRET_KEY=change-this-to-a-secure-random-jwt-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./statlearn.db

# CORS Configuration (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# AI / LLM Providers (Configure at least one for live inference, or leave empty for deterministic fallback)
AI_PROVIDER=auto
XAI_API_KEY=
XAI_MODEL=grok-2-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30.0

# iGOT Karmayogi API Integration
IGOT_API_BASE_URL=https://api.igotkarmayogi.gov.in/v1
IGOT_CLIENT_ID=
IGOT_CLIENT_SECRET=
IGOT_SANDBOX_MODE=true
